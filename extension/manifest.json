{
  "manifest_version": 3,
  "name": "Whisper Daemon Tab Capture",
  "version": "0.1.0",
  "description": "Capture tab audio for transcription by whisper-daemon",
  "permissions": ["tabCapture", "offscreen", "tabs", "notifications", "activeTab"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["rtc-tap.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "content.js",
        "wd-logic.js",
        "wd-injector.js",
        "wd-panel.js",
        "wd-captions.js",
        "wd-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Whisper Daemon"
  },
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Rozpocznij / zatrzymaj nagrywanie Whisper"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["pcm-processor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
